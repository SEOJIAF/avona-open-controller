   "defaultProperties": [],
   "properties": {
    "androidClientId": {
     "description": "iOS only - The Android client ID used in Google AppInvite when an iOS app has its Android version, for\nexample \"12345.apps.googleusercontent.com\".",
     "type": "string"
    },
    "apiKey": {
     "description": "An API key used for authenticating requests from your app, e.g.\n\"AIzaSyDdVgKwhZl0sTTTLZ7iTmt1r3N2cJLnaDk\", used to identify your app to Google servers.",
     "type": "string"
    },
    "appId": {
     "description": "The Google App ID that is used to uniquely identify an instance of an app.",
     "type": "string"
    },
    "clientId": {
     "description": "iOS only - The OAuth2 client ID for iOS application used to authenticate Google users, for example\n\"12345.apps.googleusercontent.com\", used for signing in with Google.",
     "type": "string"
    },
    "databaseURL": {
     "description": "The database root URL, e.g. \"http://abc-xyz-123.firebaseio.com\".",
     "type": "string"
    },
    "deepLinkURLScheme": {
     "description": "iOS only - The URL scheme used to set up Durable Deep Link service.",
     "type": "string"
    },
    "gaTrackingId": {
     "description": "The tracking ID for Google Analytics, e.g. \"UA-12345678-1\", used to configure Google Analytics.",
     "type": "string"
    },
    "messagingSenderId": {
     "description": "The Project Number from the Google Developer's console, for example \"012345678901\", used to\nconfigure Google Cloud Messaging.",
     "type": "string"
    },
    "projectId": {
     "description": "The Project ID from the Firebase console, for example \"abc-xyz-123\".",
     "type": "string"
    },
    "storageBucket": {
     "description": "The Google Cloud Storage bucket name, e.g. \"abc-xyz-123.storage.firebase.com\".",
     "type": "string"
